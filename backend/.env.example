# Copy this file to .env and fill values for production/dev email sending

# SendGrid (recommended)
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@yourdomain.com

# OR, if you prefer SMTP (fill these for SMTP):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Additional optional settings
# FROM_EMAIL will be used if set; otherwise SMTP_USER is used for From header

# Notes:
# - For SendGrid: create an API Key with "Mail Send" permissions and paste it above.
# - For Gmail SMTP: use an App Password (not your normal password) and ensure 2FA is enabled.
# - Keep this file secret. Do NOT commit your real .env to source control.
